DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXT_PUBLIC_SITE_URL="https://www.convertek.tech"
# IMPORTANT: do NOT set this to cloudconveter.tech / cloudconverter.tech
# (legacy domains). Sitemap, robots, and OG URLs always use www.convertek.tech.
ALLOWED_ORIGIN="https://www.convertek.tech"

# SEO / Search Console verification (optional — paste meta content values)
# Google Search Console → Settings → Ownership verification → HTML tag
# GOOGLE_SITE_VERIFICATION="your-google-verification-code"
# Bing Webmaster Tools → Ownership verification → Meta tag (msvalidate.01)
# BING_SITE_VERIFICATION="your-bing-verification-code"

# Self-hosted server defaults. On Vercel these are capped ~4MB.
MAX_UPLOAD_SIZE_MB="100"
NEXT_PUBLIC_MAX_UPLOAD_MB="100"

# Media converters (ffmpeg). Enabled automatically when NOT on Vercel.
NEXT_PUBLIC_MEDIA_ENABLED="1"
NEXT_PUBLIC_AUDIO_ENABLED="1"
NEXT_PUBLIC_VIDEO_ENABLED="1"
# FORCE_FFMPEG="1"   # optional: force-enable even on Vercel (needs ffmpeg binary)
# DISABLE_FFMPEG="1" # optional: turn off audio/video
FFMPEG_BIN=""
FFMPEG_PATH=""
# Heroku: do NOT install apt ffmpeg (conflicts with ffmpeg-static). Prefer ffmpeg-static dependency,
# or add buildpack https://github.com/heroku/heroku-buildpack-activestorage-preview

NEXT_PUBLIC_CONVERT_API_URL=""
NODE_ENV="production"
ADMIN_PASSWORD=""
# One-time admin bootstrap: POST /api/admin/setup with { email, password, secret }
ADMIN_SETUP_SECRET=""

# External toolchain (LibreOffice, Calibre, WinRAR) — keep enabled on the server
EXTERNAL_TOOLCHAIN_ENABLED="1"
EXTERNAL_TOOLCHAIN_TIMEOUT_MS="240000"

# LibreOffice (DOC and some Office conversions)
SOFFICE_BIN=""
SOFFICE_PATH=""

# Calibre (MOBI/AZW3/LRF/PDB/SNB ebook conversions)
CALIBRE_EBOOK_CONVERT_BIN=""
CALIBRE_PATH=""

# WinRAR/rar CLI (real RAR archive output)
RAR_BIN=""

# Convert concurrency on one dyno (traffic protection / “line”)
# Non-video converts in parallel (default 5), videos separately (default 1).
# Queue waiters prefer smaller files first.
CONVERT_MAX_CONCURRENT="5"
CONVERT_MAX_VIDEO="1"
CONVERT_MAX_QUEUE="20"
# Phase 3: Postgres job queue + Heroku worker dyno (keeps heavy convert off web)
# CONVERT_USE_WORKER="1"
# CONVERT_JOB_MAX_MB="20"
# heroku ps:scale worker=1

# ── Google Sign-In (optional) ──────────────────────────────────────────────
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# 2. Application type: Web application
# 3. Authorized redirect URI:
#    {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
#    e.g. http://localhost:3000/api/auth/google/callback
# 4. Authorized JavaScript origins: your site origin (e.g. http://localhost:3000)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional kill switch (unset / anything other than 0|false = on when client id set)
# GOOGLE_AUTH_ENABLED="1"
# Show "Continue with Google" on login page + auth dialog
NEXT_PUBLIC_GOOGLE_AUTH="0"

# ── Cloudflare Turnstile (bot protection) ─────────────────────────────────
# Dashboard → Turnstile → Add site (Managed / interaction-only)
# Protects: login, signup, contact, forgot-password (and admin login).
# Soft: unset both → skipped (local/dev). Production: set BOTH.
# Temporary bypass: set TURNSTILE_TEMPORARILY_DISABLED=false in src/lib/turnstile-config.ts
# or TURNSTILE_DISABLED=1 / NEXT_PUBLIC_TURNSTILE_DISABLED=1 here.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAA..."

# ── Email (Mailgun on Heroku) ─────────────────────────────────────────────
# Forgot password, contact form, and other outbound mail use Mailgun API.
# MAILGUN_DOMAIN is the Mailgun sending domain (API path), not the From address.
# MAILGUN_FROM must match a verified sender (default: noreply@convertek.tech).
# MAILGUN_API_KEY="key-..."
# MAILGUN_DOMAIN="convertek.tech"
MAILGUN_FROM="Convertek <noreply@convertek.tech>"
# SUPPORT_EMAIL="support@convertek.tech"
# Cloudflare test keys (always pass): site 1x0000000000000000000000000000000AA
#   secret 1x0000000000000000000000000000000AA

