# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/zconvert"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Admin password fallback (used if admin user has no password hash in DB)
ADMIN_PASSWORD=""

# ─── App ───────────────────────────────────────────────────────────────────────
# Public site URL (used for SEO metadata, sitemap, etc.)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Allowed CORS origin
ALLOWED_ORIGIN="*"

# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB="100"

# Node environment
NODE_ENV="production"
