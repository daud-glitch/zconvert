DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
ALLOWED_ORIGIN="*"

# Self-hosted server defaults. On Vercel these are capped ~4MB.
MAX_UPLOAD_SIZE_MB="100"
NEXT_PUBLIC_MAX_UPLOAD_MB="100"

# Media converters (ffmpeg). Enabled automatically when NOT on Vercel.
NEXT_PUBLIC_MEDIA_ENABLED="1"
NEXT_PUBLIC_AUDIO_ENABLED="1"
NEXT_PUBLIC_VIDEO_ENABLED="1"
# FORCE_FFMPEG="1"   # optional: force-enable even on Vercel (needs ffmpeg binary)
# DISABLE_FFMPEG="1" # optional: turn off audio/video
FFMPEG_BIN=""
FFMPEG_PATH=""
# Heroku: do NOT install apt ffmpeg (conflicts with ffmpeg-static). Prefer ffmpeg-static dependency,
# or add buildpack https://github.com/heroku/heroku-buildpack-activestorage-preview

NEXT_PUBLIC_CONVERT_API_URL=""
NODE_ENV="production"
ADMIN_PASSWORD=""
# One-time admin bootstrap: POST /api/admin/setup with { email, password, secret }
ADMIN_SETUP_SECRET=""

# External toolchain (LibreOffice, Calibre, WinRAR) — keep enabled on the server
EXTERNAL_TOOLCHAIN_ENABLED="1"
EXTERNAL_TOOLCHAIN_TIMEOUT_MS="240000"

# LibreOffice (DOC and some Office conversions)
SOFFICE_BIN=""
SOFFICE_PATH=""

# Calibre (MOBI/AZW3/LRF/PDB/SNB ebook conversions)
CALIBRE_EBOOK_CONVERT_BIN=""
CALIBRE_PATH=""

# WinRAR/rar CLI (real RAR archive output)
RAR_BIN=""
