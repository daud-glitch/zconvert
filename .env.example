DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
ALLOWED_ORIGIN="*"
MAX_UPLOAD_SIZE_MB="100"
NEXT_PUBLIC_MAX_UPLOAD_MB="100"
NEXT_PUBLIC_AUDIO_ENABLED="1"
NEXT_PUBLIC_CONVERT_API_URL=""
NODE_ENV="development"
ADMIN_PASSWORD=""

# External toolchain toggles (set to 1 to enable, 0 to disable)
EXTERNAL_TOOLCHAIN_ENABLED="1"
EXTERNAL_TOOLCHAIN_TIMEOUT_MS="240000"

# LibreOffice (for DOC/PPT conversions)
# You can provide one or more candidates separated by ";"
SOFFICE_BIN=""
SOFFICE_PATH=""

# Calibre (for MOBI/AZW3 conversions)
CALIBRE_EBOOK_CONVERT_BIN=""
CALIBRE_PATH=""

# WinRAR/rar CLI (for real RAR archive output)
RAR_BIN=""
